# GitHub Actions secrets for the Azure CI deploy.
#
# 1. Copy this to github-secrets.env (that copy is gitignored):
#      cp scripts/github-secrets.env.template scripts/github-secrets.env
# 2. Fill each value after the = (NO quotes, NO spaces around =).
# 3. Push them all to GitHub:
#      bash scripts/setup-github-secrets.sh
#    The script sets each secret/variable, then offers to delete this file.
#
# Leave a line blank (nothing after =) to skip that one.

# --- Azure service principal ------------------------------------------------
# From: az ad sp create-for-rbac --role Contributor \
#           --scopes /subscriptions/<ARM_SUBSCRIPTION_ID>
#   appId -> ARM_CLIENT_ID, password -> ARM_CLIENT_SECRET, tenant -> ARM_TENANT_ID
# Subscription id: az account show --query id -o tsv
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=

# --- App / service ----------------------------------------------------------
# NEON_API_KEY:         Neon console -> Account settings -> API keys
# CLOUDFLARE_API_TOKEN: Cloudflare -> My Profile -> API Tokens (R2 edit + API Tokens edit)
# CF_ACCOUNT_ID:        Cloudflare dashboard -> account id (right rail)
# POLYMNEMO_API_KEYS:   invent them, e.g.
#   echo "sk-$(openssl rand -hex 12):alice,sk-$(openssl rand -hex 12):bob"
NEON_API_KEY=
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
POLYMNEMO_API_KEYS=

# --- Test deployment + smoke checks (#129) ----------------------------------
# The test app is the same structure as prod with isolated data (its own Neon
# branch and its own R2 bucket), and the deploy pipeline gates prod on it.
#
# POLYMNEMO_TEST_API_KEYS: the TEST app's bearer keys — deliberately different
#   from POLYMNEMO_API_KEYS, so a prod key does not open test or the reverse.
#     echo "sk-$(openssl rand -hex 12):smoke"
# POLYMNEMO_TEST_SMOKE_KEY: the one key the smoke gate authenticates with. It
#   must be one of the keys in POLYMNEMO_TEST_API_KEYS above.
# POLYMNEMO_SMOKE_KEY: same, for the read-only smoke run against prod. It must
#   appear in POLYMNEMO_API_KEYS. A dedicated identity keeps the smoke run's
#   log lines out of a real user's history.
POLYMNEMO_TEST_API_KEYS=
POLYMNEMO_TEST_SMOKE_KEY=
POLYMNEMO_SMOKE_KEY=
