# GitHub Actions secrets + variables for CI/CD.
#
# 1. Copy this to github-secrets.env (that copy is gitignored):
#      cp scripts/github-secrets.env.template scripts/github-secrets.env
# 2. Fill each value after the = (NO quotes, NO spaces around =).
# 3. Push them all to GitHub:
#      bash scripts/setup-github-secrets.sh
#    The script sets each secret/variable, then offers to delete this file.
#
# Leave a line blank (nothing after =) to skip that one. Keys marked [var] are
# pushed as GitHub variables, not secrets — the script's VARS list decides that,
# so keep the two in step.

# --- Azure service principal ------------------------------------------------
# From: az ad sp create-for-rbac --role Contributor \
#           --scopes /subscriptions/<ARM_SUBSCRIPTION_ID>
#   appId -> ARM_CLIENT_ID, password -> ARM_CLIENT_SECRET, tenant -> ARM_TENANT_ID
# Subscription id: az account show --query id -o tsv
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=

# --- Terraform state backend [var] ------------------------------------------
# Created by scripts/bootstrap-tfstate-azure.sh; every root inits against these.
TFSTATE_RESOURCE_GROUP=
TFSTATE_STORAGE_ACCOUNT=
TFSTATE_CONTAINER=

# --- App / service ----------------------------------------------------------
# NEON_API_KEY:         Neon console -> Account settings -> API keys
# CLOUDFLARE_API_TOKEN: Cloudflare -> My Profile -> API Tokens (R2 edit + API Tokens edit)
# CF_ACCOUNT_ID:        Cloudflare dashboard -> account id (right rail)
# POLYMNEMO_API_KEYS:   invent them, e.g.
#   echo "sk-$(openssl rand -hex 12):alice,sk-$(openssl rand -hex 12):bob"
NEON_API_KEY=
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
POLYMNEMO_API_KEYS=

# --- GitHub OAuth (optional until #83 lands) --------------------------------
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
#   Homepage URL:  https://<deployed-host>
#   Redirect URI:  https://<deployed-host>/auth/callback   <- the path matters
# Leave both blank to keep bearer-key auth only.
POLYMNEMO_OAUTH_CLIENT_ID=
POLYMNEMO_OAUTH_CLIENT_SECRET=

# --- GCP backup deploy (optional) -------------------------------------------
# Only needed to run `deploy gcp (backup)`. GCP_SA_KEY is the whole service
# account JSON on one line. See #81 for the move to keyless (WIF).
GCP_SA_KEY=
GCP_PROJECT_ID=

# --- Gemini PR review (optional) --------------------------------------------
# GEMINI_API_KEY: https://aistudio.google.com/apikey
# GEMINI_MODEL [var]: e.g. gemini-2.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=
