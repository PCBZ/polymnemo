# Copy to terraform.tfvars and fill in. terraform.tfvars and state hold secrets —
# both are gitignored. Apply the neon root first (this reads its state).

azure_subscription_id = "00000000-0000-0000-0000-000000000000"
location              = "westus2"
acr_name              = "polymnemoacr123" # globally unique, alphanumeric
api_keys              = "sk-alice-secret:alice,sk-bob-secret:bob"

# Terraform builds the image IN ACR from the public repo (no `az acr build`).
# image_tag defaults to "v1". context_access_token is required by the provider
# even for a public repo — pass a GitHub token that can clone it (via the env var
# TF_VAR_context_access_token, not here, so it stays out of tfvars):
#   export TF_VAR_context_access_token=<github token>
# image_tag = "v1"

# --- Media (Cloudflare R2) --------------------------------------------------
# Media is always on. Apply the shared deploy/terraform/r2 root FIRST (it owns
# the ONE bucket both clouds share) — this root reads its state. No variable
# here; the bucket/creds flow in automatically.
