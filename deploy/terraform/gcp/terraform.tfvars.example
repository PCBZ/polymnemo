# Copy to terraform.tfvars and fill in. terraform.tfvars and state hold secrets —
# both are gitignored. Apply the neon + r2 roots first (this reads their state).

project_id = "your-gcp-project-id"
region     = "us-west1"
api_keys   = "sk-alice-secret:alice,sk-bob-secret:bob"

# The SAME public GHCR image Azure runs — Cloud Run pulls it directly (no
# Artifact Registry / Cloud Build). Use a tag that already exists on GHCR
# (pushed by an Azure deploy), e.g. a release version or "latest".
image = "ghcr.io/pcbz/polymnemo:v1.0.0"

# Instance sizing lives in modules/cloud-run/variables.tf.

# --- GitHub OAuth (optional) ------------------------------------------------
# Leave blank to keep this failover on bearer keys only.
#
# oauth_base_url is THIS service's URL, not Azure's — a Cloud Run URL carries a
# project-specific hash, so it only exists after the first apply. Deploy once
# with these blank, take `terraform output -raw service_url`, add
# <that>/auth/callback to the GitHub OAuth app's redirect URIs, then set them
# here and apply again.
# oauth_client_id     = "Iv23li..."
# oauth_client_secret = "..."
# oauth_base_url      = "https://polymnemo-abc123-uw.a.run.app"

# --- Remote state (Azure Storage) -------------------------------------------
# The shared neon/ + r2/ state lives in the Azure Storage backend; this root
# reads it from there, so pass the same coordinates at `terraform init
# -backend-config` and set these (needs ARM_* creds to read the shared state):
# tfstate_resource_group  = "polymnemo-tfstate-rg"
# tfstate_storage_account = "polymnemotf..."
# tfstate_container       = "tfstate"

# --- Media (Cloudflare R2) --------------------------------------------------
# Media is always on. Apply the shared deploy/terraform/r2 root FIRST (it owns
# the ONE bucket both clouds share) — this root reads its state. No variable
# here; the bucket/creds flow in automatically.
