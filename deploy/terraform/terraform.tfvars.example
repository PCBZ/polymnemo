# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (it holds
# secrets), and so is the state file that these values also end up in.

project_id = "your-gcp-project-id"
region     = "us-west1"

# Neon: Terraform creates and owns a fresh project. Get an API key from the Neon
# console → Account settings → API keys. Keep neon_region_id near `region` above.
neon_api_key   = "neon_api_key_xxx"
neon_region_id = "aws-us-west-2"

# Per-user API keys for polymnemo ("key:user_id" pairs), injected as a Cloud Run env var:
api_keys = "sk-alice-secret:alice,sk-bob-secret:bob"

# Leave `image` unset for the first (bootstrap) apply. After you build & push,
# set it and apply again to create the Cloud Run service:
# image = "us-west1-docker.pkg.dev/your-gcp-project-id/polymnemo/polymnemo:v1"

# Instance sizing (memory / cpu / max_instances / concurrency) is set in
# modules/cloud-run/variables.tf — change it there if you need to tune.
