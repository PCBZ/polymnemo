# polymnemo configuration — copy to .env and set what you need. Local dev runs
# with no changes (in-memory store); production requires POLYMNEMO_DATABASE_URL.
# (.env is gitignored.)

# --- Storage ---
# Postgres (Neon + pgvector) connection string — the durable, shared store.
# REQUIRED in production; leave empty only for local dev/tests, where it falls
# back to the in-memory store (not durable, not shared across instances).
# On Neon use the POOLED connection string. One-time setup:
#   pip install -e .
#   psql "<connection string>" -f scripts/schema.sql
POLYMNEMO_DATABASE_URL=
# Fail fast if the URL is unset instead of using in-memory (the production
# Docker image sets this to true; leave false for local dev).
POLYMNEMO_REQUIRE_DATABASE=false

# --- HTTP transport ---
# Bind host. Use 0.0.0.0 in a container; 127.0.0.1 for local dev.
POLYMNEMO_HOST=127.0.0.1
# Port. On Cloud Run, $PORT is injected and takes over automatically.
POLYMNEMO_PORT=8000
# Streamable HTTP endpoint path.
POLYMNEMO_MCP_PATH=/mcp

# --- Embeddings ---
# Multilingual model so Chinese / cross-language recall works out of the box.
# Defaults to the model in src/polymnemo/config.py (the single source of truth);
# uncomment only to override. Changing it means re-embedding everything.
# POLYMNEMO_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Must match the model's output dimension (pinned into the DB schema).
POLYMNEMO_EMBED_DIM=384
# Embedder backend: "fastembed" (real model) or "stub" (offline dev / tests).
POLYMNEMO_EMBED_BACKEND=fastembed

# --- Chunking (in tokens; keep under the model's context window) ---
POLYMNEMO_CHUNK_TOKENS=120
POLYMNEMO_CHUNK_OVERLAP_TOKENS=20

# --- Namespaces ---
# Default collection when a tool omits one.
POLYMNEMO_DEFAULT_NAMESPACE=shared
# Comma-separated namespaces readable by all users ("born shared"); everything
# else is private to its owner. Writes are always owner-scoped.
POLYMNEMO_SHARED_NAMESPACES=shared
# Where save_session stores transcripts by default. Keep this OUT of
# POLYMNEMO_SHARED_NAMESPACES so session content stays private to its owner.
POLYMNEMO_SESSION_NAMESPACE=sessions
# Where create_upload stores media by default. Also kept private — media bytes
# are more likely personal, and a download URL hands over the actual file.
POLYMNEMO_MEDIA_NAMESPACE=media

# --- Rate limiting (one global token bucket; off by default) ---
# Caps this instance's overall intake (not per-user), in ops per minute.
# Embed-heavy tools (remember/recall) cost 2 tokens; cheap reads cost 1.
POLYMNEMO_RATELIMIT_ENABLED=false
POLYMNEMO_RATELIMIT_PER_MIN=600

# --- Blob storage (large / multimedia memories, #44) ---
# "none" (default, media tools off) or "s3" (Cloudflare R2 / S3-compatible).
# Bytes go to object storage via presigned URLs; Postgres keeps only a pointer +
# searchable description. The boto3 dependency ships by default.
POLYMNEMO_BLOB_BACKEND=none
POLYMNEMO_BLOB_BUCKET=
POLYMNEMO_BLOB_ENDPOINT_URL=
POLYMNEMO_BLOB_ACCESS_KEY_ID=
POLYMNEMO_BLOB_SECRET_ACCESS_KEY=
POLYMNEMO_BLOB_URL_TTL=900
# Max upload size (bytes), enforced at confirm_upload (rejects + deletes an
# oversized object). 25 MiB.
POLYMNEMO_BLOB_MAX_BYTES=26214400

# --- Auth ---
# "bearer" (per-user keys, the real scheme) or "static" (dev, single fixed user).
POLYMNEMO_AUTH_BACKEND=bearer
# Per-user keys: "key1:alice,key2:bob". Required when AUTH_BACKEND=bearer.
POLYMNEMO_API_KEYS=
